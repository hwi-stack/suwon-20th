rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // RSVP Validation
    function isValidRsvp(data) {
      return data.keys().hasAll(['organization', 'name', 'phone', 'consent', 'createdAt'])
        && data.keys().size() == 5
        && data.organization is string && data.organization.size() > 0 && data.organization.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 20
        && data.consent is bool && data.consent == true
        && data.createdAt == request.time;
    }

    // RSVP Match Block
    match /rsvps/{rsvpId} {
      allow create: if isValidId(rsvpId) && isValidRsvp(request.resource.data);
      allow read, list, update, delete: if isAdmin();
    }

    // Admin Match Block
    match /admins/{adminId} {
      allow get, create: if isSignedIn() && request.auth.uid == adminId;
      allow list, update, delete: if isAdmin();
    }
  }
}
